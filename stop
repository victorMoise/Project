#!/usr/bin/env bash
#
# Stops the dotnet services started by ./start. Docker infra (Postgres,
# Keycloak) is left running by default — pass --infra (or --all) to bring it
# down too.
#
# Usage: ./stop [--infra]

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"
PID_DIR="$ROOT_DIR/.dev/pids"

log() { printf '\033[1;34m[stop]\033[0m %s\n' "$1"; }

stop_service() {
  local name=$1 pid_file="$PID_DIR/$1.pid"
  if [[ -f "$pid_file" ]] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
    local pid
    pid=$(cat "$pid_file")
    log "Stopping $name (pid $pid)..."
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  else
    log "$name is not running."
  fi
  rm -f "$pid_file"
}

stop_service collections-service
stop_service gateway

if [[ "${1:-}" == "--infra" || "${1:-}" == "--all" ]]; then
  log "Stopping Docker infra (Postgres, Keycloak)..."
  (cd infra && docker compose down)
fi
